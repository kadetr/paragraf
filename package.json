{
  "name": "paragraf-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:e2e": "vitest run --config tests/vitest.config.ts",
    "golden:update": "UPDATE_GOLDEN=1 vitest run --config tests/vitest.config.ts tests/golden",
    "golden:preview": "GOLDEN_PREVIEW=1 vitest run --config tests/vitest.config.ts tests/golden",
    "manual": "tsx tests/manual/run-all.ts",
    "verify-fonts": "tsx scripts/setup-fonts.ts",
    "pack:check": "node scripts/pack-check.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "trail": "node scripts/trail.mjs",
    "format:check": "prettier --check"
  },
  "workspaces": [
    "0-types",
    "0-color",
    "2c-color-wasm",
    "1a-linebreak",
    "1b-font-engine",
    "1c-layout",
    "1d-style",
    "2a-shaping-wasm",
    "2b-render-core",
    "3a-typography",
    "3b-render-pdf",
    "4a-template",
    "4b-compile",
    "studio",
    "demo"
  ],
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "prettier": "3.10.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "vite": "^8.0.11",
    "vitest": "^4.1.12"
  }
}
