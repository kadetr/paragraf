{
  "name": "@paragraf/types",
  "version": "0.7.1",
  "description": "Shared TypeScript interfaces and constants for the paragraf typography library",
  "license": "MIT",
  "author": "kadetr (https://github.com/kadetr)",
  "repository": {
    "type": "git",
    "url": "https://github.com/kadetr/paragraf.git",
    "directory": "0-types"
  },
  "homepage": "https://github.com/kadetr/paragraf/tree/main/0-types#readme",
  "keywords": [
    "typography",
    "typesetting",
    "paragraf"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../scripts/publishconfig-swap.mjs apply",
    "postpack": "node ../scripts/publishconfig-swap.mjs restore",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^4.1.12",
    "tsup": "^8.5.1"
  }
}
