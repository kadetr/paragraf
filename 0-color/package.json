{
  "name": "@paragraf/color",
  "version": "0.7.1",
  "description": "ICC color management for the paragraf typography library",
  "license": "MIT",
  "author": "kadetr (https://github.com/kadetr)",
  "repository": {
    "type": "git",
    "url": "https://github.com/kadetr/paragraf.git",
    "directory": "0-color"
  },
  "homepage": "https://github.com/kadetr/paragraf/tree/main/0-color#readme",
  "keywords": [
    "typography",
    "typesetting",
    "color",
    "icc",
    "paragraf"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../scripts/publishconfig-swap.mjs apply",
    "postpack": "node ../scripts/publishconfig-swap.mjs restore"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.12"
  }
}
